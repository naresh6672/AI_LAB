step = 0

def hanoi(n, source, target, aux):
    global step
    # Base case: Only one disk to move
    if n == 1:
        step += 1
        print(f"Step {step}: Move disk 1 from {source} to {target}")
        return

    # Move n-1 disks from source to auxiliary peg
    hanoi(n - 1, source, aux, target)
    
    # Move the nth disk from source to target peg
    step += 1
    print(f"Step {step}: Move disk {n} from {source} to {target}")
    
    # Move the n-1 disks from auxiliary peg to target peg
    hanoi(n - 1, aux, target, source)

# Driver Code
print("=== Tower of Hanoi (3 disks) ===")
print("Pegs: A (Source) | B (Auxiliary) | C (Target)\n")

hanoi(3, 'A', 'C', 'B')

print(f"\nTotal steps: {step}")
