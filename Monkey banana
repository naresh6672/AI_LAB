def monkey_banana():
    state = {"monkey": "door", "box": "window", "banana": "middle", "has": False}
    print("Initial State:", state)
    
    state["monkey"] = "window"
    print("In Step 1: Monkey walks from door to window")
    print("State:", state)
    
    state["box"] = "middle"
    print("In Step 2: Monkey pushes box from window to middle")
    print("State:", state)
    
    state["monkey"] = "middle"
    print("In Step 3: Monkey walks to middle (climbs box)")
    print("State:", state)
    
    state["has"] = True
    print("In Step 4: Monkey grabs the banana!")
    print("State:", state)
    
    print("Goal Achieved: Monkey has the banana!")

monkey_banana()
