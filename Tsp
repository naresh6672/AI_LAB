import random
import math

# Coordinates of the cities
cities = [(0,0), (1,3), (4,3), (6,1)]

def distance(a, b):
    return math.dist(a, b)

def total_cost(route):
    cost = 0
    for i in range(len(route)):
        # Calculates distance between current city and next city (looping back to start)
        cost += distance(route[i], route[(i + 1) % len(route)])
    return cost

def hill_climbing():
    # Start with a random initial route
    current = cities[:]
    random.shuffle(current)
    
    while True:
        neighbors = []
        # Generate all possible neighbor routes by swapping two cities
        for i in range(len(current)):
            for j in range(i + 1, len(current)):
                n = current[:]
                n[i], n[j] = n[j], n[i]
                neighbors.append(n)
        
        # Find the neighbor with the minimum cost
        best = min(neighbors, key=total_cost)
        
        # If the best neighbor isn't better than the current route, we've reached a peak
        if total_cost(best) >= total_cost(current):
            print("Best route: ", current)
            print("Cost: ", total_cost(current))
            return
        
        current = best

# To execute the function
hill_climbing()
